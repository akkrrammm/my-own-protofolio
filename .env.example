# Copy to .env.local and fill in.

# Production URL — used for metadataBase, canonical/hreflang links, the
# sitemap, robots.txt, JSON-LD and social cards. Defaults to the Vercel URL
# below when unset; change it here (or in Vercel) for a custom domain.
NEXT_PUBLIC_SITE_URL=https://my-own-protofolio.vercel.app

# Contact form endpoint (Formspree). Defaults to the form below when unset;
# point it at another Formspree form to send messages elsewhere.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/mvkkdwpl
