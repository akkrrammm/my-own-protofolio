# Copy to .env.local and fill in.

# Production URL — used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: any endpoint that accepts a JSON POST (Formspree, Web3Forms,
# Getform, or your own API). Leave empty and the contact form opens the
# visitor's email app with the message pre-filled instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=
